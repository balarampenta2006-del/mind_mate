# ── SMHC Frontend configuration ────────────────────────
# Copy this file to `.env` and adjust as needed.

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:8080/api

# true  → use isolated mock data (no backend required)
# false → talk to the real API
VITE_USE_MOCK=false

# App display name
VITE_APP_NAME=Mind Mate

# ── SMHC Backend configuration ─────────────────────────
# Copy this file to `.env` and fill in real values.

# HTTP port the API listens on
PORT=8080

# development | test | production
NODE_ENV=development

# Secret used to sign JWTs. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT lifetime
JWT_EXPIRES_IN=7d

# MongoDB connection string (optional — the API falls back to an
# in-memory store when this is unset or unreachable).
# Local:   mongodb://localhost:27017/smhc
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smhc?retryWrites=true&w=majority
MONGODB_URI=

# Allowed CORS origins (comma separated). Defaults to * in development.
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=
